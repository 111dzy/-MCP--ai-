# 统一换行符，避免 Windows/Linux 协作时满屏 diff
* text=auto

# 源码
*.c      text
*.h      text
*.cpp    text
*.hpp    text
*.py     text
*.js     text
*.ts     text
*.json   text
*.md     text
*.yml    text
*.yaml   text

# Windows 脚本保持 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 三维模型与图片：必须标为二进制，否则 git 会尝试按文本合并导致文件损坏
*.stl    binary
*.obj    binary
*.ply    binary
*.glb    binary
*.gltf   binary
*.fbx    binary
*.3mf    binary
*.step   binary
*.stp    binary
*.iges   binary
*.igs    binary
*.FCStd  binary
*.FCStd1 binary
*.blend  binary
*.skp    binary
*.dwg    binary
*.dxf    binary

# 图片 / 音视频
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.webp   binary
*.mp4    binary
*.mov    binary
*.mp3    binary
*.wav    binary

# 文档
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.pptx   binary
*.zip    binary
